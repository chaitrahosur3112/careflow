# Base URL of the Django backend REST API.
# In dev this is unused — Vite proxies /api to http://localhost:8000 (see vite.config.js).
# In production, point this at your deployed backend origin, e.g. https://api.careflow.example.com
VITE_API_BASE_URL=/api

# Base URL for the WebSocket connection (live queue board).
# In production this should be wss://<your-backend-domain> (Channels/Daphne, not the ML service).
VITE_WS_BASE_URL=ws://localhost:8000
