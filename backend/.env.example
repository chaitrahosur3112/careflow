# Django
DJANGO_SECRET_KEY=change-this-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database: either provide full DATABASE_URL (Render PostgreSQL / Neon / Supabase)
# or individual POSTGRES_* credentials (local Docker Compose)
DATABASE_URL=
POSTGRES_DB=careflow
POSTGRES_USER=careflow_user
POSTGRES_PASSWORD=careflow_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (optional — falls back to in-memory channel layer / cache if unset)
REDIS_URL=redis://localhost:6379/0

# CORS & CSRF — frontend origin(s), comma separated
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:5173,http://localhost:3000

# ML microservice (FastAPI) URL
ML_SERVICE_URL=http://localhost:8001

# Production SSL redirect (leave False if SSL terminates at Render edge proxy)
SECURE_SSL_REDIRECT=False
