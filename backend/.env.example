# Django
DJANGO_SECRET_KEY=change-this-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=careflow
POSTGRES_USER=careflow_user
POSTGRES_PASSWORD=careflow_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS — frontend origin(s), comma separated
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# ML microservice (FastAPI)
ML_SERVICE_URL=http://localhost:8001

# Optional — used only by backend/entrypoint.sh under Docker Compose to
# auto-create an Admin account on first boot, for the viva demo. Leave
# unset to skip (you can always `python manage.py createsuperuser`).
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Production only
SECURE_SSL_REDIRECT=False
